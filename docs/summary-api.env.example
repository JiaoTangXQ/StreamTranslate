# Summary only. Copy these settings to .env in the project root.
# Never put your real key in this example or commit .env.
MODEL_PROVIDER=zhizengzeng
ZHIZENGZENG_OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.zhizengzeng.com/v1
OPENAI_MODEL=deepseek-v4.1-flash
CHAT_COMPLETIONS_MAX_TOKENS=32768
CHAT_COMPLETIONS_MAX_CONCURRENT_REQUESTS=12
CHAT_COMPLETIONS_REQUESTS_PER_SECOND=20
CHAT_COMPLETIONS_INSECURE_TLS=false
